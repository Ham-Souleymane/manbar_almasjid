rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imam verification documents
    match /imams/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Mosque photos (anyone can view them, but only the owner/imam can upload/delete)
    match /mosques/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
