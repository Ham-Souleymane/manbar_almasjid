rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Imam profiles: Only the authenticated Imam can read/write their own profile
    match /imams/{imamId} {
      allow read, write: if request.auth != null && request.auth.uid == imamId;
    }
    
    // Mosque documents: Everyone can read, but only authenticated users can write/update
    match /mosques/{mosqueId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.imamId == request.auth.uid || mosqueId == request.auth.uid);
      
      // Nested subcollections
      
      // Stats: only authenticated imams can access
      match /stats/{document} {
        allow read, write: if request.auth != null;
      }
      
      // Posts: everyone can read, only authenticated imams of the mosque can write
      match /posts/{document} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      // Prayer Times: everyone can read, only authenticated imams of the mosque can write
      match /prayerTimes/{document} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
